          "script": {
            "exec": [
              "// For the generate first name\r",
              "var firstName = pm.variables.replaceIn('{{$randomFirstName}}');\r",
              "pm.environment.set(\"fName\", firstName);\r",
              "\r",
              "// For the generate last name\r",
              "var lastName = pm.variables.replaceIn('{{$randomLastName}}');\r",
              "pm.environment.set(\"lName\", lastName);\r",
              "\r",
              "// For the generate totalprice\r",
              "var totalPrice = pm.variables.replaceIn('{{$randomInt}}');\r",
              "pm.environment.set(\"tPrice\", totalPrice);\r",
              "\r",
              "// For the generate depositpaid\r",
              "var depositPaid = pm.variables.replaceIn('{{$randomBoolean}}');\r",
              "pm.environment.set(\"dpaid\", depositPaid);\r",
              "\r",
              "// For the generate checkin date\r",
              "var checkin = require('moment');\r",
              "console.log(checkin);\r",
              "\r",
              "var checkinDate = checkin().format('YYYY-MM-DD');\r",
              "console.log(checkinDate);\r",
              "pm.environment.set(\"cinDate\", checkinDate);\r",
              "\r",
              "// For the generate checkout date\r",
              "var checkout = require('moment');\r",
              "var checkoutDate = checkout().add(4, 'd').format('YYYY-MM-DD');\r",
              "\r",
              "pm.environment.set(\"coutDate\", checkoutDate);\r",
              "\r",
              "// For the generate additionalneeds\r",
              "var additionalNeeds = pm.variables.replaceIn('{{$randomBsNoun}}');\r",
              "pm.environment.set(\"aNeeds\", additionalNeeds);"
